# Copia este archivo como .env para desarrollo local (opcional).
# Cadena de conexión de Supabase (Project Settings → Database → Connection string → "Transaction pooler").
# Sin esta variable, la app usa una base local en ./data.
DATABASE_URL=postgresql://postgres.xxxxxxxx:[TU-CONTRASEÑA]@aws-0-us-east-1.pooler.supabase.com:6543/postgres

# Tu token de acceso (mínimo 16 caracteres). Tu enlace será /t/<ACCESS_TOKEN>.
ACCESS_TOKEN=
